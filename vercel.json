{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)\\.(mp4|jpg|png|svg|mjs)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/contact",
      "destination": "/heisenworks_frontend/api/contact"
    },
    {
      "source": "/",
      "destination": "/heisenworks_frontend/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/heisenworks_frontend/$1"
    }
  ]
}
