# Copy to .env (local) or add in Cloudflare → Workers & Pages → project → Settings → Variables.
# Never commit real keys.

# "Start a project" lead emails (lib/lead.js via functions/api/contact.js) — sent with Resend (https://resend.com)
RESEND_API_KEY=
LEAD_TO_EMAIL=info@heisenworks.in
# Sender address on a domain verified in Resend
LEAD_FROM_EMAIL="HeisenWorks Website <leads@heisenworks.in>"
